{#{% set attributes = variant and (variant != 'primary') ? attributes.addClass('pf-m-' ~ variant) : "pf-m-primary" %}#}

<button {{ attributes.addClass("pf-v6-c-button", "pf-m-" ~ variant) }}>
  <span class="pf-v6-c-button__text">{{ Text }}</span>
</button>

{#{% if '_' in variant %}
  {% set attributes = variant | split('_') %}
